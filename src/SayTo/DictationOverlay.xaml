<Window x:Class="SayTo.DictationOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SayTo" Width="540" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        Focusable="False">

    <Border Background="#F2161A26" CornerRadius="14" Padding="16,12,12,14"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="LiveDot" Width="9" Height="9" Fill="#8B7CFF"
                         VerticalAlignment="Center" />
                <TextBlock x:Name="LblListening" Grid.Column="1" Text="Listening…"
                           Foreground="#FFFFFF" FontSize="13" Margin="9,0,0,0"
                           VerticalAlignment="Center" FontFamily="{StaticResource Font.Medium}" />
                <TextBlock x:Name="LblTarget" Grid.Column="2" Margin="12,0,0,0"
                           Foreground="#8A93A8" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="BtnStop" Grid.Column="3" Width="34" Height="30"
                        Cursor="Hand" Focusable="False" Click="BtnStop_Click"
                        ToolTip="Finish (same shortcut)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#22FFFFFF" CornerRadius="8">
                                <Path Data="{StaticResource Icon.Stop}" Stroke="#FFFFFF"
                                      StrokeThickness="2" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#44FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnCancel" Grid.Column="4" Width="34" Height="30" Margin="6,0,0,0"
                        Cursor="Hand" Focusable="False" Click="BtnCancel_Click"
                        ToolTip="Cancel (Esc)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="Transparent" CornerRadius="8">
                                <Path Data="{StaticResource Icon.Close}" Stroke="#8A93A8"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#22FFFFFF" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TextBlock x:Name="PartialText" Margin="1,9,0,0" Foreground="#D7DBE6"
                       FontSize="13.5" TextWrapping="Wrap" MaxHeight="58"
                       TextTrimming="CharacterEllipsis"
                       FontFamily="{StaticResource Font.Base}" />
        </StackPanel>
    </Border>
</Window>
