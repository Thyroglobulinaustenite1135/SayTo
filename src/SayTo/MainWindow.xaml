<Window x:Class="SayTo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SayTo" Width="780" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" ShowInTaskbar="True"
        Icon="pack://application:,,,/SayTo;component/Assets/sayto.ico"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="MicButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg" Fill="{DynamicResource Brush.AccentGrad}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" CornerRadius="12"
            Background="{DynamicResource Brush.Window}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.4" />
        </Border.Effect>

        <Grid TextElement.FontFamily="{StaticResource Font.Base}">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===================== Title bar ===================== -->
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_Drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="pack://application:,,,/SayTo;component/Assets/logo.png"
                       Width="24" Height="24" Margin="16,0,9,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="SayTo" FontFamily="{StaticResource Font.Bold}"
                           FontSize="14" VerticalAlignment="Center" />

                <Border Grid.Column="3" Background="{DynamicResource Brush.Card}"
                        CornerRadius="9" Padding="3" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SegFa" Content="فارسی" Style="{StaticResource SegRadio}"
                                     GroupName="reclang" Checked="SegLang_Changed" ToolTip="Persian" />
                        <RadioButton x:Name="SegEn" Content="English" Style="{StaticResource SegRadio}"
                                     GroupName="reclang" Checked="SegLang_Changed" />
                    </StackPanel>
                </Border>

                <Button x:Name="BtnTheme" Grid.Column="4" Style="{StaticResource IconButton}"
                        Click="BtnTheme_Click" Margin="0,0,2,0">
                    <Grid>
                        <Path x:Name="IconSun" Data="{StaticResource Icon.Sun}" Style="{StaticResource StrokeIcon}" Visibility="Collapsed" />
                        <Path x:Name="IconMoon" Data="{StaticResource Icon.Moon}" Style="{StaticResource StrokeIcon}" />
                    </Grid>
                </Button>
                <Button x:Name="BtnSettings" Grid.Column="5" Style="{StaticResource IconButton}"
                        Click="BtnSettings_Click" Margin="0,0,2,0">
                    <Path Data="{StaticResource Icon.Sliders}" Style="{StaticResource StrokeIcon}" />
                </Button>
                <Button x:Name="BtnMin" Grid.Column="6" Style="{StaticResource IconButton}"
                        Click="BtnMin_Click" Margin="0,0,2,0">
                    <Path Data="{StaticResource Icon.Min}" Style="{StaticResource StrokeIcon}" />
                </Button>
                <Button x:Name="BtnClose" Grid.Column="7" Style="{StaticResource CloseButton}"
                        Click="BtnClose_Click" Margin="0,0,10,0">
                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource StrokeIcon}" />
                </Button>
            </Grid>

            <!-- ===================== Content ===================== -->
            <Grid Grid.Row="1" Margin="16,2,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- transcript card -->
                <Border Background="{DynamicResource Brush.Card}" CornerRadius="12"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="Placeholder" Text="…" Margin="16,13,16,0"
                                   Foreground="{DynamicResource Brush.TextDim}" FontSize="14"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="Transcript" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent" BorderThickness="0" Padding="14,12"
                                 FontSize="15" Foreground="{DynamicResource Brush.Text}"
                                 CaretBrush="{DynamicResource Brush.Caret}"
                                 SelectionBrush="{DynamicResource Brush.Selection}"
                                 FontFamily="{StaticResource Font.Base}"
                                 TextChanged="Transcript_TextChanged" />
                    </Grid>
                </Border>

                <!-- bottom bar -->
                <Grid Grid.Row="1" Margin="2,14,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- status -->
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9"
                                     Fill="{DynamicResource Brush.Good}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="12.5"
                                       Foreground="{DynamicResource Brush.TextDim}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="190" />
                        </StackPanel>
                        <TextBlock x:Name="HintText" Margin="17,5,0,0" FontSize="11"
                                   Foreground="{DynamicResource Brush.TextDim}" Opacity="0.75" />
                    </StackPanel>

                    <!-- mic + waveform -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="BarsL" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Grid Grid.Column="1" Width="88" Height="88">
                            <Ellipse x:Name="PulseRing" Stroke="{DynamicResource Brush.Accent}"
                                     StrokeThickness="2" Opacity="0" IsHitTestVisible="False"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Button x:Name="MicButton" Style="{StaticResource MicButton}"
                                    Margin="10" Click="MicButton_Click" ToolTipService.InitialShowDelay="400">
                                <Grid>
                                    <Path x:Name="MicIcon" Data="{StaticResource Icon.Mic}"
                                          Stroke="White" StrokeThickness="1.8" Width="30" Height="30"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" Stretch="Uniform" />
                                    <Path x:Name="StopIcon" Data="{StaticResource Icon.Stop}"
                                          Stroke="White" StrokeThickness="2.2" Width="24" Height="24"
                                          StrokeLineJoin="Round" Visibility="Collapsed" />
                                </Grid>
                                <Button.ToolTip>
                                    <ToolTip x:Name="MicTip" />
                                </Button.ToolTip>
                            </Button>
                        </Grid>
                        <StackPanel x:Name="BarsR" Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>

                    <!-- actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnCopy" Style="{StaticResource GhostButton}"
                                Click="BtnCopy_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Copy}" Style="{StaticResource StrokeIcon}" />
                                <TextBlock x:Name="TxtCopy" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnClear" Style="{StaticResource GhostButton}"
                                Click="BtnClear_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Trash}" Style="{StaticResource StrokeIcon}" />
                                <TextBlock x:Name="TxtClear" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnInsert" Style="{StaticResource GhostButton}"
                                Click="BtnInsert_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Insert}" Style="{StaticResource StrokeIcon}" />
                                <TextBlock x:Name="TxtInsert" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ============ first-run model setup overlay ============ -->
                <Grid x:Name="SetupOverlay" Grid.RowSpan="2" Visibility="Collapsed"
                      Background="{DynamicResource Brush.Scrim}">
                    <Border Width="500" Background="{DynamicResource Brush.Card}"
                            CornerRadius="14" Padding="24"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" />
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="pack://application:,,,/SayTo;component/Assets/logo.png"
                                       Width="30" Height="30" VerticalAlignment="Center" />
                                <TextBlock x:Name="SetupTitle" Margin="10,0,0,0" FontSize="16"
                                           FontFamily="{StaticResource Font.Bold}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="SetupDesc" Margin="0,10,0,4" FontSize="12"
                                       Foreground="{DynamicResource Brush.TextDim}"
                                       TextWrapping="Wrap" />

                            <!-- fa row -->
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Width="120" VerticalAlignment="Center">
                                    <TextBlock x:Name="SetupFaName" FontSize="13"
                                               FontFamily="{StaticResource Font.Medium}" />
                                    <TextBlock x:Name="SetupFaSize" FontSize="10.5"
                                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ProgressBar x:Name="ProgFa" Grid.Column="1" VerticalAlignment="Center"
                                             Margin="8,0" Visibility="Collapsed" Maximum="100" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="StateFa" FontSize="11.5"
                                               Foreground="{DynamicResource Brush.TextDim}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button x:Name="BtnDlFa" Style="{StaticResource IconButton}"
                                            Click="BtnDlFa_Click">
                                        <Path Data="{StaticResource Icon.Download}" Style="{StaticResource StrokeIcon}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- en row -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Width="120" VerticalAlignment="Center">
                                    <TextBlock x:Name="SetupEnName" FontSize="13"
                                               FontFamily="{StaticResource Font.Medium}" />
                                    <TextBlock x:Name="SetupEnSize" FontSize="10.5"
                                               Foreground="{DynamicResource Brush.TextDim}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ProgressBar x:Name="ProgEn" Grid.Column="1" VerticalAlignment="Center"
                                             Margin="8,0" Visibility="Collapsed" Maximum="100" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="StateEn" FontSize="11.5"
                                               Foreground="{DynamicResource Brush.TextDim}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button x:Name="BtnDlEn" Style="{StaticResource IconButton}"
                                            Click="BtnDlEn_Click">
                                        <Path Data="{StaticResource Icon.Download}" Style="{StaticResource StrokeIcon}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,22,0,0">
                                <Button x:Name="BtnLater" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Click="BtnLater_Click" />
                                <Button x:Name="BtnDlAll" Style="{StaticResource AccentButton}"
                                        HorizontalAlignment="Right" Click="BtnDlAll_Click" Padding="16,8" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            <!-- ============ settings popup ============ -->
            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=BtnSettings}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Width="310" Background="{DynamicResource Brush.Card}" CornerRadius="12"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="18"
                Margin="0,6,14,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.45" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="SettingsTitle" FontSize="14"
                           FontFamily="{StaticResource Font.Bold}" />

                <TextBlock x:Name="LblHotkey" Margin="0,14,0,6" FontSize="11.5"
                           Foreground="{DynamicResource Brush.TextDim}" />
                <Border Background="{DynamicResource Brush.Window}" CornerRadius="9"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Hk0" Style="{StaticResource SegRadio}" GroupName="hk"
                                     Checked="HotKey_Changed" />
                        <RadioButton x:Name="Hk1" Style="{StaticResource SegRadio}" GroupName="hk"
                                     Checked="HotKey_Changed" />
                        <RadioButton x:Name="Hk2" Style="{StaticResource SegRadio}" GroupName="hk"
                                     Checked="HotKey_Changed" />
                    </StackPanel>
                </Border>

                <CheckBox x:Name="ChkAutoStop" Style="{StaticResource ModernCheck}"
                          Margin="0,14,0,0" Checked="AutoStop_Changed" Unchecked="AutoStop_Changed" />
                <StackPanel x:Name="AutoStopRow" Orientation="Horizontal" Margin="26,8,0,0">
                    <Slider x:Name="SlAutoStop" Style="{StaticResource ModernSlider}" Width="130"
                            Minimum="1" Maximum="6" TickFrequency="0.5" IsSnapToTickEnabled="True"
                            ValueChanged="AutoStopSlider_Changed" VerticalAlignment="Center" />
                    <TextBlock x:Name="LblAutoStopSec" Margin="10,0,0,0" FontSize="11.5"
                               Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                </StackPanel>

                <CheckBox x:Name="ChkInsertAfter" Style="{StaticResource ModernCheck}"
                          Margin="0,12,0,0" Checked="InsertAfter_Changed" Unchecked="InsertAfter_Changed" />

                <TextBlock x:Name="LblUiLang" Margin="0,16,0,6" FontSize="11.5"
                           Foreground="{DynamicResource Brush.TextDim}" />
                <Border Background="{DynamicResource Brush.Window}" CornerRadius="9"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="3"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Ux1" Style="{StaticResource SegRadio}" GroupName="ux"
                                     Checked="UiLang_Changed" />
                        <RadioButton x:Name="Ux2" Style="{StaticResource SegRadio}" GroupName="ux"
                                     Checked="UiLang_Changed" />
                    </StackPanel>
                </Border>

                <Button x:Name="BtnModels" Style="{StaticResource GhostButton}" Margin="0,16,0,0"
                        HorizontalAlignment="Left" Click="BtnModels_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource StrokeIcon}" />
                        <TextBlock x:Name="TxtModels" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock x:Name="TxtAbout" Margin="0,12,0,0" FontSize="10.5"
                           Foreground="{DynamicResource Brush.TextDim}" Opacity="0.85"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Popup>
        </Grid>
    </Border>

</Window>
