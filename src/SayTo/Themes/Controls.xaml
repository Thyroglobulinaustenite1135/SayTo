                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Fonts ===== -->
    <FontFamily x:Key="Font.Base">pack://application:,,,/SayTo;component/Assets/fonts/Vazirmatn-Regular.ttf#Vazirmatn, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Medium">pack://application:,,,/SayTo;component/Assets/fonts/Vazirmatn-Medium.ttf#Vazirmatn, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Bold">pack://application:,,,/SayTo;component/Assets/fonts/Vazirmatn-Bold.ttf#Vazirmatn, Segoe UI</FontFamily>

